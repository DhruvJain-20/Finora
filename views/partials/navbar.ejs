<nav class="navbar">
    <a href="/transactions-page" class="brand">Finora</a>

    <div class="nav-links">
        <a href="/transactions-page">Transactions</a>
        <a href="/budgets-page">Budgets</a>
        <a href="/analysis">Analysis</a>
        <a href="/savings">Savings Goals</a>
        <a href="/ai-insights">AI Insights</a>
        <a href="/ai-chat">AI Copilot</a>
        <button id="nav-link" style="color: black;border: 1px solid #000;background: #fafaff; height: 30px;border-radius: 5px;">SignOut</button>
    </div>
    <script>
        let signOutLink = document.getElementById('nav-link');
        signOutLink.addEventListener('click', function(event) {
            event.preventDefault();
            fetch('/signout', { method: 'POST' })
                .then(response => {
                    if (response.ok) {
                        window.location.href = '/';
                    } else {
                        console.error('Sign out failed.');
                    }
                })
                .catch(error => {
                    console.error('Error during sign out:', error);
                });
        });
    </script>
</nav>
