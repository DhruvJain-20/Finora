
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | Finora</title>
    <link rel="stylesheet" href="/navigation.css">
    <link rel="stylesheet" href="/auth.css">
    <link rel="stylesheet" href="/signup.css">
</head>
<body>
    <!-- <%- include('partials/navbar') %> -->

    <main class="auth-container">
        <form id="signup-form" class="auth-card">
            <h1>Create your Finora account</h1>
            <p>Start managing your finances in one place.</p>

            <label for="signup-email">Email</label>
            <input type="email" id="signup-email" required autocomplete="email">

            <label for="signup-password">Password</label>
            <input type="password" id="signup-password"
                   required minlength="8" autocomplete="new-password">

            <button type="submit">Create Account</button>
            <p id="signup-message" role="status"></p>

            <p>Already have an account? <a href="/login">Log in</a></p>
        </form>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
    const supabaseClient = window.supabase.createClient(
        '<%= supabaseUrl %>',
        '<%= supabasePublishableKey %>'
    );
</script>
    <script src="/signup.js"></script>
</body>
</html>
