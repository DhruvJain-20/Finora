<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Savings Goals | Finora</title>
    <link rel="stylesheet" href="savings.css">
    <link rel="stylesheet" href="/navigation.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body>
    <%- include('partials/navbar') %>
    <form id="savings_form">
        <h3>Set Your Savings Goal</h3>
        <br>
        <pre>Goal Name:     </pre>
        <input type="text" name="goal_name" placeholder="Enter goal name" id="goal_name" required>
        <br>
        <br>
        <pre>Target Amount: </pre>
        <input type="number" name="target_amount" placeholder="Enter target amount" id="target_amount" min="1" required>
        <br>
        <br>
        <pre>Deadline:      </pre>
        <input type="date" name="target_date" id="target_date" required>
        <br>
        <br>
        <input type="submit" value="Set Goal">
    </form>
    <br>
    <hr>
    <h3>Current Goals </h3>
    <div id="current_goals"></div>
    <br>
    <script src="savings.js"></script>
</body>
</html>
