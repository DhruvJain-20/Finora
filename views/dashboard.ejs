<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finora</title>
    <link rel="stylesheet" href="dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body>
    <div id="f">
    <form id="transaction_form">
        <pre>Amount:        </pre>
        <input type="number" name="amount" placeholder="Enter amount" id="amt">
        <br>
        <br>
        <pre>Type:          </pre>
        <select id="type" name="type">
            <option>Select Type</option>
            <option value="Income">Income</option>
            <option value="Expense">Expense</option>
        </select>
        <br>
        <br>
        <pre>Category:      </pre>
        <select id="category" name="category">
            <option>Select Category</option>
            <option value="Food">Food</option>
            <option value="Shopping">Shopping</option>
            <option value="Transport">Transport</option>
            <option value="Bills">Bills</option>
            <option value="Entertainment">Entertainment</option>
            <option value="Healthcare">Healthcare</option>
            <option value="Other">Other</option>
        </select>
        <br>
        <br>
        <pre>Description:   </pre>
        <input type="text" name="description" placeholder="Enter description" id="description">
        <br>
        <br>
        <pre>Merchant:      </pre>
        <input type="text" name="merchant" placeholder="Enter merchant name" id="merchant">
        <br>
        <br>
        <pre>Date:          </pre>
        <input type="date" name="date" id="date">
        <br>
        <br>
        <pre>Payment:       </pre>
        <select id="payment">
            <option>Select mode of payment</option>
            <option value="UPI">UPI</option>
            <option value="Credit Card">Credit Card</option>
            <option value="Debit Card">Debit Card</option>
            <option value="Netbanking">Netbanking</option>
            <option value="Cash">Cash</option>
        </select>
        <br>
        <br>
        <input type="submit" id="submit_t" value="Add Transaction">
    </form>
    </div>
    <p id="c">Income: </p>
    <div id="income"> 
    </div>
    <p id="c">Expense: </p>
    <div id="expense">
    </div>
    <p id="c">Total Expenses Category-wise :</p> 
    <div id="cat">
    </div>
    <div id="tot">
    </div>
    <script src="dashboard.js"></script>
</body>
</html>